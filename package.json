{
  "name": "alexa-remote-mqtt",
  "version": "1.0.0",
  "description": "Bridge between Amazon Echo devices and MQTT",
  "main": "src/bridge.js",
  "scripts": {
    "start": "node bin/alexa-remote-mqtt.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\""
  },
  "keywords": [
    "alexa",
    "echo",
    "amazon",
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "home-automation",
    "home-assistant",
    "alexa-remote2"
  ],
  "author": "Sebastian \"hobbyquaker\" Raff <hobbyquaker@gmail.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "alexa-remote-mqtt": "bin/alexa-remote-mqtt.js"
  },
  "dependencies": {
    "alexa-remote2": "^8.1.1",
    "mqtt": "^5.15.2",
    "yargs": "^18.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/alexa-remote-mqtt.git"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/alexa-remote-mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/alexa-remote-mqtt#readme",
  "preferGlobal": true,
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
